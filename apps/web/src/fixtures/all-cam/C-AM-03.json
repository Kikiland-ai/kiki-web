          "conceptId": "C-AM-03",
          "kind": "am",
          "title": "Conventional AM, envelope and modulation index",
          "controls": [
            {
              "name": "mu",
              "label": "Modulation index",
              "min": 0.0,
              "max": 1.5,
              "step": 0.1,
              "default": 0.5,
              "unit": ""
            }
          ],
          "visualBrief": {
            "kind": "waveform",
            "description": "Compare conventional AM envelopes for mu=0.5 and mu=1.5; show zero crossings and label envelope distortion rather than implying all demodulators fail.",
            "alt": "Conventional AM, envelope and modulation index; Conventional AM includes carrier plus sidebands. For ordinary envelope recovery, keep mu at or below one.",
            "from": {
              "origin": "curated",
              "label": "MathWorks: analog passband modulation; reference for the modulation families",
              "url": "https://www.mathworks.com/help/comm/ug/analog-passband-modulation.html"
            }
          },
          "walkthrough": [
            {
              "dim": "words",
              "mark": "sweep",
              "say": "For a single tone, conventional AM is s(t)=Ac[1+mu*cos(2*pi*fm*t)]cos(2*pi*fc*t).",
              "target": "Conventional AM"
            },
            {
              "dim": "concept",
              "mark": "marker",
              "say": "Use an envelope comparison to distinguish conventional AM from our suppressed-carrier lab waveform.",
              "target": "modulation index"
            },
            {
              "dim": "concept",
              "mark": "marker",
              "say": "Conventional AM includes carrier plus sidebands. For ordinary envelope recovery, keep mu at or below one.",
              "target": "overmodulation"
            }
          ],
          "sourceInteractive": {
            "kind": "step_through",
            "prompt": "Follow the explanation, then check the worked result.",
            "steps": [
              {
                "detail": "For a single tone, conventional AM is s(t)=Ac[1+mu*cos(2*pi*fm*t)]cos(2*pi*fc*t).",
                "label": "Define"
              },
              {
                "detail": "mu=(6-2)/(6+2)=0.5.",
                "label": "Apply"
              },
              {
                "detail": "This is 50% modulation and is not overmodulated.",
                "label": "Check"
              }
            ]
          },
          "assumptions": [
            "Authored draft; scientific review pending",
