              "min": 10.0,
              "max": 1000.0,
              "step": 10.0,
              "default": 100.0,
              "unit": "Hz"
            },
            {
              "name": "phase",
              "label": "Phase",
              "min": 0.0,
              "max": 180.0,
              "step": 15.0,
              "default": 0.0,
              "unit": "degree"
            }
          ],
          "visualBrief": {
            "kind": "waveform",
            "description": "Draw two labelled time traces with equal frequency and different amplitudes; a third trace has a phase shift. Show 10 ms period for 100 Hz.",
            "alt": "Amplitude, frequency and phase; Peak size: amplitude. Cycles per second: frequency. Relative timing: phase. Convert Hz using 2*pi*f.",
            "from": {
              "origin": "curated",
              "label": "MathWorks: analog passband modulation; reference for the modulation families",
              "url": "https://www.mathworks.com/help/comm/ug/analog-passband-modulation.html"
            }
          },
          "walkthrough": [
            {
              "dim": "words",
              "mark": "sweep",
              "say": "A sinusoid is x(t)=A sin(2*pi*f*t+phi): A is amplitude, f is frequency in Hz and phi is phase in radians.",
              "target": "Amplitude"
            },
            {
              "dim": "concept",
              "mark": "marker",
              "say": "Set a 100 Hz message source using Frequency = 2*pi*100 rad/s; inspect one cycle lasting 10 ms.",
              "target": "frequency"
            },
            {
              "dim": "concept",
              "mark": "marker",
              "say": "Peak size: amplitude. Cycles per second: frequency. Relative timing: phase. Convert Hz using 2*pi*f.",
              "target": "phase"
            }
          ],
          "sourceInteractive": {
            "inputs": [
              {
                "default": 100,
                "label": "Frequency",
                "max": 1000,
                "min": 10,
                "name": "f",
                "step": 10,
                "unit": "Hz"
              }
            ],
            "kind": "parameter_sweep",
            "outputs": [
              {
                "formula": "1/f",
                "label": "Period",
                "name": "T",
                "unit": "s"
              },
              {
                "formula": "2*pi*f",
                "label": "Angular frequency",
                "name": "omega",
                "unit": "rad/s"
              }
            ],
            "prompt": "Change frequency and observe period and angular frequency."
          },
          "assumptions": [
