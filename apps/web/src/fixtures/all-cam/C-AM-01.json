          "kind": "signal",
          "title": "Amplitude, frequency and phase",
          "controls": [
            {
              "name": "amplitude",
              "label": "Amplitude",
              "min": 0.25,
              "max": 2.0,
              "step": 0.25,
              "default": 1.0,
