# Copy to .env.development.local for npm run dev:connected.
VITE_APP_MODE=connected
VITE_API_BASE_URL=http://127.0.0.1:8000
# Public Firebase web configuration only. Never put Admin credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-kiki-local
VITE_FIREBASE_APP_ID=
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# Remove emulator URL for a deliberately configured staging project.
