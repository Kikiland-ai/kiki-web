# Public identifiers only. Server credentials use Application Default Credentials.
KIKI_FIREBASE_PROJECT_ID=builder-cup-a8479
KIKI_FIRESTORE_DATABASE=(default)
# Enable only after a private bucket and approved bucket-level IAM are ready:
# KIKI_STORAGE_BUCKET=builder-cup-a8479.firebasestorage.app
KIKI_CORS_ORIGINS=["http://127.0.0.1:5174","http://localhost:5174"]
# Optional, isolated local credentials (configured in this workspace):
# CLOUDSDK_CONFIG=.tools/gcloud-config
# Cloud is the default. No fixture/skip-auth runtime mode is provided.
KIKI_ENVIRONMENT=cloud
