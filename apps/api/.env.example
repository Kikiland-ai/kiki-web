# Public identifiers only. Server credentials use Application Default Credentials.
KIKI_FIREBASE_PROJECT_ID=builder-cup-a8479
KIKI_FIRESTORE_DATABASE=(default)
# Enable only after a private bucket and approved bucket-level IAM are ready:
# KIKI_STORAGE_BUCKET=builder-cup-a8479.firebasestorage.app
KIKI_CORS_ORIGINS=["http://127.0.0.1:5174","http://localhost:5174"]
# Optional, isolated local credentials (configured in this workspace):
# CLOUDSDK_CONFIG=.tools/gcloud-config
# Cloud is the default. No fixture/skip-auth runtime mode is provided.
KIKI_ENVIRONMENT=cloud
# Lab execution is opt-in. Keep disabled until the local backend/extension are ready.
KIKI_LAB_EXECUTION_MODE=disabled
# Local-only review: mode=local and this exact loopback origin, one API worker.
# KIKI_LAB_BACKEND_ORIGIN=http://127.0.0.1:8100
# KIKI_LAB_PROXY_SECRET=<server-only random secret, 32+ characters; never VITE_*>
# Emulator mode requires demo-kiki-local plus BOTH localhost SDK host variables.
# KIKI_ENVIRONMENT=emulator
# KIKI_FIREBASE_PROJECT_ID=demo-kiki-local
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Never place credentials in VITE_* or commit a service-account JSON.

# Tutor mode (off by default). The Gemini key is server-only; never VITE_*.
# KIKI_TUTOR_ENABLED=true
# KIKI_GEMINI_API_KEY=<server-only Gemini API key>
# KIKI_TUTOR_CLASSIFIER_MODEL=gemini-3.5-flash-lite
# KIKI_TUTOR_LIVE_MODEL=gemini-3.8-live
